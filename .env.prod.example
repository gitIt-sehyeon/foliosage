RDS_HOST=foliosage-db.xxxxxx.ap-northeast-2.rds.amazonaws.com
POSTGRES_DB=foliosage
POSTGRES_USER=foliosage
POSTGRES_PASSWORD=change-me

BACKEND_PORT=8080

JWT_SECRET=change-this-to-a-long-random-256-bit-secret-before-deploying
JWT_EXPIRATION_MS=86400000

VAULTSAGE_API_KEY=your-vaultsage-api-key
VAULTSAGE_BASE_URL=https://api.vaultsage.ai

CORS_ORIGINS=https://foliosage.cloud,https://www.foliosage.cloud
APP_BASE_URL=https://foliosage.cloud
APP_FRONTEND_URL=https://foliosage.cloud

GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
